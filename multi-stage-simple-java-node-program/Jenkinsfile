pipeline{
    agent none
    stages{
        stage('Java app - Backend'){
            agent{
                docker {image 'openjdk:24-slim'}
            }
            steps{
                sh 'cp multi-stage-simple-java-node-program/helloWorld.java helloWorld.java'
                sh 'ls -l'
                sh 'javac helloWorld.java'
                sh 'java helloWorld'
            }
            
        }
        stage('Node - Frontend'){
            agent{
                docker {image 'node:slim'}
            }
            steps{
                sh 'cp multi-stage-simple-java-node-program/frontend.js frontend.js'
                sh 'node frontend.js'
            }
        }
    }
}