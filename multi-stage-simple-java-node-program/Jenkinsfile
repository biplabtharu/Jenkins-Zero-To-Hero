pipeline{
    agent none
    stages{
        stage('Java app - Backend'){
            agent{
                docker {image 'openjdk:24-slim'}
            }
            steps{
                sh 'cp multi-stage-simple-java-node-program/helloWorld.java /tmp/helloWorld.java'
                sh 'ls -l tmp'
            }
            
        }
        stage('Node - Frontend'){
            agent{
                docker {image 'node:slim'}
            }
            steps{
                sh 'cp multi-stage-simple-java-node-program/frontend.js /tmp/frontend.js'
                sh 'node /tmp/frontend.js'
            }
        }
    }
}